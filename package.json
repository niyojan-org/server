{
  "name": "orgatick-server",
  "version": "1.0.0",
  "description": "Server of orgatick backend",
  "homepage": "https://github.com/niyojan-org/v1#readme",
  "bugs": {
    "url": "https://github.com/niyojan-org/v1/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niyojan-org/v1.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:ts": "tsc",
    "build:alias": "tsc-alias --resolve-full-paths --resolve-full-extension .js",
    "build:assets": "mkdir -p dist/infra && cp -R src/infra/mail_templates dist/infra/mail_templates",
    "build": "pnpm run build:ts && pnpm run build:alias && pnpm run build:assets",
    "start": "node dist/server.js",
    "generate-vapid-keys": "tsx scripts/generate-vapid-keys.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.66.4",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.1.2",
    "mongoose-paginate-v2": "^1.9.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "pg": "^8.17.1",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.16.0",
    "@types/speakeasy": "^2.0.10",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  }
