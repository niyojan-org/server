{
  "name": "orgatick-server",
  "version": "1.0.0",
  "description": "Server of orgatick backend",
  "homepage": "https://github.com/niyojan-org/v1#readme",
  "bugs": {
    "url": "https://github.com/niyojan-org/v1/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niyojan-org/v1.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:ts": "tsc",
    "build:alias": "tsc-alias --resolve-full-paths --resolve-full-extension .js",
    "build:assets": "mkdir -p dist/infra && cp -R src/infra/mail_templates dist/infra/mail_templates",
    "build": "pnpm run build:ts && pnpm run build:alias && pnpm run build:assets",
    "start": "node dist/server.js",
    "generate-vapid-keys": "tsx scripts/generate-vapid-keys.ts",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.5",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.1",
    "mongoose-paginate-v2": "^1.9.4",
    "multer": "^2.1.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "sonar-scanner": "^3.1.0",
    "speakeasy": "^2.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/speakeasy": "^2.0.10",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.1"
  }
}
