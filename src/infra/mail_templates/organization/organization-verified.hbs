<div class="content">
    <h1>Your Organization is Now Verified!</h1>

    <p>Hello {{ownerName}},</p>

    <p>
        Excellent news! <strong>{{organizationName}}</strong> has been successfully verified by the Orgatick platform.
    </p>

    <!-- Success Badge -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 25px 0; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 8px; padding: 24px 20px;">
        <tr>
            <td align="center">
                <img width="64" height="64"
                    src="https://cdn.jsdelivr.net/gh/niyojan-org/email-assets/icons/lineal/shield-check.png"
                    alt="verified" class="dark-mode-safe"
                    style="-ms-interpolation-mode: bicubic; color: transparent; display: block; margin: 0 auto 16px;" />
                <h3 style="color: #ffffff; font-family: Arial, sans-serif; font-size: 22px; margin: 0 0 8px 0;">
                    Verified Organization
                </h3>
                <p style="color: #ffffff; font-family: Arial, sans-serif; font-size: 15px; margin: 0;">
                    Your organization profile now displays the verified badge
                </p>
            </td>
        </tr>
    </table>

    <p>
        This verification badge helps build trust with your audience and shows that your organization has been
        authenticated by our platform.
    </p>

    <!-- Unlocked Features -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 25px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <h3 style="font-family: Arial, sans-serif; font-size: 18px; color: #1f2937; margin: 0 0 16px 0; text-align: center;">
                    ✨ What's New for You
                </h3>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                    style="max-width: 480px; margin: 0 auto;">
                    <tr>
                        <td style="padding: 10px 0; text-align: center;">
                            <img width="24" height="24"
                                src="https://cdn.jsdelivr.net/gh/niyojan-org/email-assets/icons/lineal/badge.png"
                                alt="badge" class="dark-mode-safe"
                                style="-ms-interpolation-mode: bicubic; color: transparent; display: inline-block; vertical-align: middle; margin-right: 8px;" />
                            <span
                                style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; font-weight: bold; vertical-align: middle;">Verified
                                badge on your profile and events</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 0; text-align: center;">
                            <img width="24" height="24"
                                src="https://cdn.jsdelivr.net/gh/niyojan-org/email-assets/icons/lineal/trending.png"
                                alt="visibility" class="dark-mode-safe"
                                style="-ms-interpolation-mode: bicubic; color: transparent; display: inline-block; vertical-align: middle; margin-right: 8px;" />
                            <span
                                style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; font-weight: bold; vertical-align: middle;">Increased
                                visibility in search results</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 0; text-align: center;">
                            <img width="24" height="24"
                                src="https://cdn.jsdelivr.net/gh/niyojan-org/email-assets/icons/lineal/trust.png"
                                alt="trust" class="dark-mode-safe"
                                style="-ms-interpolation-mode: bicubic; color: transparent; display: inline-block; vertical-align: middle; margin-right: 8px;" />
                            <span
                                style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; font-weight: bold; vertical-align: middle;">Enhanced
                                credibility with your audience</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 10px 0; text-align: center;">
                            <img width="24" height="24"
                                src="https://cdn.jsdelivr.net/gh/niyojan-org/email-assets/icons/lineal/star.png"
                                alt="premium" class="dark-mode-safe"
                                style="-ms-interpolation-mode: bicubic; color: transparent; display: inline-block; vertical-align: middle; margin-right: 8px;" />
                            <span
                                style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; font-weight: bold; vertical-align: middle;">Access
                                to premium features and support</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    {{> button
    url=organizationUrl
    label="View Your Organization"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="20px"
    }}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    Congratulations on this milestone! Keep creating amazing events.
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 10px 0 0 0;">
                    Best regards,<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
