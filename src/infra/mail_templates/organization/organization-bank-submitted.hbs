<div class="content">
    <h1>Bank Details Submitted for Verification</h1>

    <p>Hello {{ownerName}},</p>

    <p>
        Thank you for submitting bank details for <strong>{{organizationName}}</strong>. We've received your
        information and it's currently under review.
    </p>

    <!-- Submission Confirmation -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 25px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td align="center">
                <img width="48" height="48"
                    src="https://cdn.jsdelivr.net/gh/niyojan-org/email-assets/icons/lineal/bank.png"
                    alt="bank" class="dark-mode-safe"
                    style="-ms-interpolation-mode: bicubic; color: transparent; display: block; margin: 0 auto 12px;" />
                <p style="font-family: Arial, sans-serif; font-size: 16px; color: #1f2937; margin: 0; font-weight: bold;">
                    Bank Details Received
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #6b7280; margin: 8px 0 0 0;">
                    Submitted on {{submittedDate}}
                </p>
            </td>
        </tr>
    </table>

    <!-- Submission Details -->
    {{#if bankName}}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; border-left: 4px solid #004aad; padding-left: 16px;">
        <tr>
            <td>
                <h3 style="font-family: Arial, sans-serif; font-size: 18px; color: #1f2937; margin: 0 0 12px 0;">
                    Submitted Information:
                </h3>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0;">
                    Bank Name: <strong>{{bankName}}</strong>
                </p>
                {{#if accountNumber}}
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 8px 0 0 0;">
                    Account Number: {{accountNumber}}
                </p>
                {{/if}}
            </td>
        </tr>
    </table>
    {{/if}}

    <p>
        Our team will review your bank details to ensure everything is in order. This typically takes
        <strong>1-2 business days</strong>.
    </p>

    <!-- What Happens Next -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 25px 0; background-color: #ecfdf5; border-left: 4px solid #10b981; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #065f46; margin: 0 0 8px 0;">
                    <strong>Next Steps:</strong>
                </p>
                <ul style="font-family: Arial, sans-serif; font-size: 14px; color: #065f46; line-height: 1.8; margin: 0; padding-left: 20px;">
                    <li>Our team will verify your bank information</li>
                    <li>You'll receive a confirmation email once approved</li>
                    <li>Paid event features will be enabled after verification</li>
                    <li>If any issues arise, we'll contact you for clarification</li>
                </ul>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0 0 8px 0;">
                    <strong>Security:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0;">
                    Your bank information is encrypted and stored securely. We never share your financial details
                    with third parties without your consent.
                </p>
            </td>
        </tr>
    </table>

    {{> button
    url=dashboardUrl
    label="View Dashboard"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="20px"
    }}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    If you have any questions about the verification process, feel free to contact our support team.
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 10px 0 0 0;">
                    Best regards,<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
