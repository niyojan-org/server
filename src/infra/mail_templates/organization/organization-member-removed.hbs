<div class="content">
    <h1>You've Been Removed from {{organizationName}}</h1>

    <p>Hello {{memberName}},</p>

    <p>
        We're writing to inform you that you've been removed from <strong>{{organizationName}}</strong> by
        <strong>{{removedBy}}</strong>.
    </p>

    <!-- Removal Info -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 25px 0; background-color: #fef2f2; border-left: 4px solid #dc2626; padding: 20px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0 0 8px 0;">
                    <strong>Access Status:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0;">
                    You no longer have access to this organization's events, dashboard, or any related resources.
                </p>
            </td>
        </tr>
    </table>

    {{#if removalReason}}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; border-left: 4px solid #004aad; padding-left: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937; margin: 0 0 8px 0;">
                    <strong>Reason:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0;">
                    {{removalReason}}
                </p>
            </td>
        </tr>
    </table>
    {{/if}}

    <!-- What This Means -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 25px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <h3 style="font-family: Arial, sans-serif; font-size: 18px; color: #1f2937; margin: 0 0 12px 0;">
                    What this means:
                </h3>
                <ul style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; line-height: 1.8; margin: 0; padding-left: 20px;">
                    <li>You can no longer manage or view organization events</li>
                    <li>Your access to the organization dashboard has been revoked</li>
                    <li>You cannot perform any actions on behalf of the organization</li>
                    <li>Your personal Orgatick account remains active and unaffected</li>
                </ul>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #ecfdf5; border-left: 4px solid #10b981; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #065f46; margin: 0 0 8px 0;">
                    <strong>Your Account is Safe:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #065f46; margin: 0;">
                    This removal only affects your membership in this specific organization. You can still access
                    your personal account, join events, and create your own organization if you wish.
                </p>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    If you believe this was a mistake or have questions, please contact the organization administrator
                    directly or reach out to our support team.
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 10px 0 0 0;">
                    Best regards,<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
