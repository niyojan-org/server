<div class="content">
    <h1>Event Tomorrow!</h1>

    <p>Hello {{name}},</p>

    <p>
        This is a friendly reminder that <strong>{{eventName}}</strong> is happening tomorrow!
    </p>

    <!-- Event Details Card -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background: linear-gradient(135deg, #004aad 0%, #002f6c 100%); border-radius: 8px; padding: 24px;">
        <tr>
            <td>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="padding: 8px 0;">
                            <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                Event Name
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 18px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                {{eventName}}
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 16px 0 8px 0;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td width="50%" style="padding-right: 10px;">
                                        <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                            Date
                                        </p>
                                        <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                            {{eventDate}}
                                        </p>
                                    </td>
                                    <td width="50%" style="padding-left: 10px;">
                                        <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                            Time
                                        </p>
                                        <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                            {{eventTime}}
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 16px 0 8px 0;">
                            <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                Location
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                {{eventLocation}}
                            </p>
                        </td>
                    </tr>
                    {{#if checkInTime}}
                    <tr>
                        <td style="padding: 16px 0 0 0;">
                            <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                Check-in Time
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                {{checkInTime}}
                            </p>
                        </td>
                    </tr>
                    {{/if}}
                </table>
            </td>
        </tr>
    </table>

    {{#if qrCode}}
    <!-- QR Code Section -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #ffffff; border: 2px solid #004aad; border-radius: 8px; padding: 24px;">
        <tr>
            <td align="center">
                <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #004aad; margin: 0 0 16px 0;">
                    Your Event Ticket
                </p>
                <img src="{{qrCode}}" alt="Ticket QR Code" class="dark-mode-safe"
                    style="width: 180px; height: 180px; display: block; margin: 0 auto; -ms-interpolation-mode: bicubic; color: transparent;" />
                <p style="font-family: Arial, sans-serif; font-size: 13px; color: #6b7280; margin: 16px 0 0 0;">
                    Don't forget to bring your ticket!
                </p>
            </td>
        </tr>
    </table>
    {{/if}}

    {{#if directions}}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937; margin: 0 0 8px 0;">
                    <strong>How to get there:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0;">
                    {{{directions}}}
                </p>
            </td>
        </tr>
    </table>
    {{/if}}

    {{#if parkingInfo}}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937; margin: 0 0 8px 0;">
                    <strong>Parking Information:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0;">
                    {{{parkingInfo}}}
                </p>
            </td>
        </tr>
    </table>
    {{/if}}

    {{#if ticketUrl}}
    {{> button
    url=ticketUrl
    label="View Your Ticket"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="10px"
    }}
    {{/if}}

    {{#if eventUrl}}
    {{> button
    url=eventUrl
    label="Event Details"
    variant="secondary"
    fullWidth=true
    marginTop="10px"
    marginBottom="20px"
    }}
    {{/if}}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f3f4f6; border-radius: 6px; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0 0 8px 0;">
                    <strong>Pre-Event Checklist:</strong>
                </p>
                <ul style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0; padding-left: 20px;">
                    <li style="margin: 4px 0;">Have your ticket ready (digital or printed)</li>
                    <li style="margin: 4px 0;">Plan your route and arrival time</li>
                    <li style="margin: 4px 0;">Check weather conditions and dress accordingly</li>
                    <li style="margin: 4px 0;">Bring any required documents or items</li>
                </ul>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    Looking forward to seeing you!<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
