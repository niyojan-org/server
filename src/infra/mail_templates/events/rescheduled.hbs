<div class="content">
    <h1>Event Rescheduled</h1>

    <p>Hello {{name}},</p>

    <p>
        We're writing to inform you that <strong>{{eventName}}</strong> has been rescheduled.
    </p>

    {{#if reason}}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0 0 8px 0;">
                    <strong>Reason:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0;">
                    {{{reason}}}
                </p>
            </td>
        </tr>
    </table>
    {{/if}}

    <!-- Previous Schedule -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f3f4f6; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #6b7280; margin: 0 0 12px 0; text-decoration: line-through;">
                    Previous Schedule
                </p>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td width="50%" style="padding-right: 10px;">
                            <p style="font-family: Arial, sans-serif; font-size: 13px; color: #6b7280; margin: 0;">
                                Date
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 15px; color: #6b7280; margin: 4px 0 0 0;">
                                {{oldDate}}
                            </p>
                        </td>
                        <td width="50%" style="padding-left: 10px;">
                            <p style="font-family: Arial, sans-serif; font-size: 13px; color: #6b7280; margin: 0;">
                                Time
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 15px; color: #6b7280; margin: 4px 0 0 0;">
                                {{oldTime}}
                            </p>
                        </td>
                    </tr>
                    {{#if oldLocation}}
                    <tr>
                        <td colspan="2" style="padding-top: 12px;">
                            <p style="font-family: Arial, sans-serif; font-size: 13px; color: #6b7280; margin: 0;">
                                Location
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 15px; color: #6b7280; margin: 4px 0 0 0;">
                                {{oldLocation}}
                            </p>
                        </td>
                    </tr>
                    {{/if}}
                </table>
            </td>
        </tr>
    </table>

    <!-- New Schedule -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background: linear-gradient(135deg, #004aad 0%, #002f6c 100%); border-radius: 8px; padding: 24px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 0 0 16px 0;">
                    New Schedule
                </p>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="padding: 8px 0;">
                            <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                Event Name
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 18px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                {{eventName}}
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 16px 0 8px 0;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td width="50%" style="padding-right: 10px;">
                                        <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                            New Date
                                        </p>
                                        <p style="font-family: Arial, sans-serif; font-size: 18px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                            {{newDate}}
                                        </p>
                                    </td>
                                    <td width="50%" style="padding-left: 10px;">
                                        <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                            New Time
                                        </p>
                                        <p style="font-family: Arial, sans-serif; font-size: 18px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                            {{newTime}}
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    {{#if newLocation}}
                    <tr>
                        <td style="padding: 16px 0 0 0;">
                            <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                {{#if oldLocation}}New {{/if}}Location
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                {{newLocation}}
                            </p>
                        </td>
                    </tr>
                    {{/if}}
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #dcfce7; border-left: 4px solid #16a34a; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #166534; margin: 0;">
                    <strong>Good News:</strong> Your ticket is still valid! No action is required from your side.
                </p>
            </td>
        </tr>
    </table>

    {{#if eventUrl}}
    {{> button
    url=eventUrl
    label="View Updated Event Details"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="20px"
    }}
    {{/if}}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f3f4f6; border-radius: 6px; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0 0 8px 0;">
                    <strong>What you need to know:</strong>
                </p>
                <ul style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0; padding-left: 20px;">
                    <li style="margin: 4px 0;">Your existing ticket remains valid for the new date</li>
                    <li style="margin: 4px 0;">Save the new date to your calendar</li>
                    <li style="margin: 4px 0;">We'll send reminders before the event</li>
                    <li style="margin: 4px 0;">If you can't attend, contact support for refund options</li>
                </ul>
            </td>
        </tr>
    </table>

    <p style="font-family: Arial, sans-serif; font-size: 14px; color: #6b7280; margin-top: 20px;">
        We apologize for any inconvenience and appreciate your understanding.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    See you at the event!<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
