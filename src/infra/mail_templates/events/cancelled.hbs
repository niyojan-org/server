<div class="content">
    <h1>Event Cancelled</h1>

    <p>Hello {{name}},</p>

    <p>
        We regret to inform you that <strong>{{eventName}}</strong> scheduled for <strong>{{eventDate}}</strong> has been cancelled.
    </p>

    <!-- Cancellation Notice -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #fee2e2; border-left: 4px solid #dc2626; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0 0 8px 0;">
                    <strong>Reason for Cancellation:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0;">
                    {{{cancellationReason}}}
                </p>
            </td>
        </tr>
    </table>

    <p>
        We sincerely apologize for any inconvenience this may cause.
    </p>

    {{#if refundAmount}}
    <!-- Refund Information -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background: linear-gradient(135deg, #004aad 0%, #002f6c 100%); border-radius: 8px; padding: 24px;">
        <tr>
            <td>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="padding: 8px 0;">
                            <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 0;">
                                Refund Information
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 16px 0 8px 0;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td width="50%" style="padding-right: 10px;">
                                        <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                            Refund Amount
                                        </p>
                                        <p style="font-family: Arial, sans-serif; font-size: 20px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                            {{refundAmount}}
                                        </p>
                                    </td>
                                    {{#if refundDate}}
                                    <td width="50%" style="padding-left: 10px;">
                                        <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                            Expected By
                                        </p>
                                        <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                            {{refundDate}}
                                        </p>
                                    </td>
                                    {{/if}}
                                </tr>
                            </table>
                        </td>
                    </tr>
                    {{#if refundMethod}}
                    <tr>
                        <td style="padding: 16px 0 0 0;">
                            <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                Refund Method
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                {{refundMethod}}
                            </p>
                        </td>
                    </tr>
                    {{/if}}
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937; margin: 0 0 8px 0;">
                    <strong>What happens next?</strong>
                </p>
                <ul style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0; padding-left: 20px;">
                    <li style="margin: 4px 0;">Your refund will be processed automatically</li>
                    <li style="margin: 4px 0;">Funds will be credited to your original payment method</li>
                    <li style="margin: 4px 0;">Processing may take 5-7 business days</li>
                    <li style="margin: 4px 0;">You'll receive a confirmation once the refund is complete</li>
                </ul>
            </td>
        </tr>
    </table>
    {{/if}}

    {{#if supportUrl}}
    {{> button
    url=supportUrl
    label="Contact Support"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="20px"
    }}
    {{/if}}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f3f4f6; border-radius: 6px; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0 0 8px 0;">
                    <strong>Need Help?</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0;">
                    If you have any questions about this cancellation or your refund, please contact our support team{{#if supportEmail}} at <a href="mailto:{{supportEmail}}" style="color: #004aad; text-decoration: none;">{{supportEmail}}</a>{{/if}}.
                </p>
            </td>
        </tr>
    </table>

    <p style="font-family: Arial, sans-serif; font-size: 14px; color: #6b7280; margin-top: 20px;">
        We hope to see you at future events.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="center">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    Best regards,<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
