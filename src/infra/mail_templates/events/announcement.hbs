<div class="content">
    <h1>{{announcementTitle}}</h1>

    <p>Hello {{name}},</p>

    <p>
        We have an important update regarding <strong>{{eventName}}</strong>.
    </p>

    <!-- Announcement Content -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 24px;">
        <tr>
            <td>
                <div style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; line-height: 1.6;">
                    {{{announcementBody}}}
                </div>
            </td>
        </tr>
    </table>

    {{#if eventDate}}
    <!-- Event Details Card -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background: linear-gradient(135deg, #004aad 0%, #002f6c 100%); border-radius: 8px; padding: 24px;">
        <tr>
            <td>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="padding: 8px 0;">
                            <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                Event Name
                            </p>
                            <p style="font-family: Arial, sans-serif; font-size: 18px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                {{eventName}}
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 16px 0 8px 0;">
                            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                                <tr>
                                    <td width="50%" style="padding-right: 10px;">
                                        <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                            Date
                                        </p>
                                        <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                            {{eventDate}}
                                        </p>
                                    </td>
                                    {{#if eventTime}}
                                    <td width="50%" style="padding-left: 10px;">
                                        <p style="font-family: Arial, sans-serif; font-size: 14px; color: #ffffff; margin: 0; opacity: 0.9;">
                                            Time
                                        </p>
                                        <p style="font-family: Arial, sans-serif; font-size: 16px; font-weight: bold; color: #ffffff; margin: 4px 0 0 0;">
                                            {{eventTime}}
                                        </p>
                                    </td>
                                    {{/if}}
                                </tr>
                            </table>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
    {{/if}}

    {{#if speakerInfo}}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; margin: 0 0 8px 0;">
                    <strong>Speaker Information:</strong>
                </p>
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; line-height: 1.6;">
                    {{{speakerInfo}}}
                </div>
            </td>
        </tr>
    </table>
    {{/if}}

    {{#if agendaUpdate}}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; margin: 0 0 8px 0;">
                    <strong>Agenda Update:</strong>
                </p>
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; line-height: 1.6;">
                    {{{agendaUpdate}}}
                </div>
            </td>
        </tr>
    </table>
    {{/if}}

    {{#if venueMap}}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; margin: 0 0 12px 0;">
                    <strong>Venue Map:</strong>
                </p>
                <img src="{{venueMap}}" alt="Venue Map" class="dark-mode-safe"
                    style="max-width: 100%; height: auto; display: block; border-radius: 6px; -ms-interpolation-mode: bicubic; color: transparent;" />
            </td>
        </tr>
    </table>
    {{/if}}

    {{#if parkingInfo}}
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; margin: 0 0 8px 0;">
                    <strong>Parking Information:</strong>
                </p>
                <div style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; line-height: 1.6;">
                    {{{parkingInfo}}}
                </div>
            </td>
        </tr>
    </table>
    {{/if}}

    {{#if attachmentUrl}}
    {{> button
    url=attachmentUrl
    label="View Attachment"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="10px"
    }}
    {{/if}}

    {{#if eventUrl}}
    {{> button
    url=eventUrl
    label="View Event Details"
    variant="secondary"
    fullWidth=true
    marginTop="10px"
    marginBottom="20px"
    }}
    {{/if}}

    <p style="font-family: Arial, sans-serif; font-size: 14px; color: #6b7280; margin-top: 20px;">
        We'll keep you updated with any further information.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    Best regards,<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
