<div class="content">
    <h1>🎉 Registration Confirmed!</h1>

    <p>Hi {{name}},</p>

    <p>
        Great news! Your registration for <strong>{{eventName}}</strong> has been confirmed.
    </p>

    <div class="event-details" style="background-color: #f3f4f6; padding: 20px; border-radius: 6px; margin: 20px 0;">
        <h3 style="margin-top: 0;">Event Details</h3>
        <p><strong>Event:</strong> {{eventName}}</p>
        <p><strong>Date:</strong> {{formatDate eventDate}}</p>
        <p><strong>Time:</strong> {{eventTime}}</p>
        <p><strong>Venue:</strong> {{eventVenue}}</p>
        {{#if ticketNumber}}
        <p><strong>Ticket Number:</strong> {{ticketNumber}}</p>
        {{/if}}
    </div>

    <p>
        We're excited to see you there! Please keep this email for your records.
    </p>

    {{> button
        url=eventUrl
        label="View Event Details"
        variant="primary"
        fullWidth=true
        marginTop="20px"
        marginBottom="20px"
    }}

    <p style="font-size: 14px; color: #6b7280;">
        <strong>Need to make changes?</strong><br>
        You can manage your registration anytime through your account dashboard.
    </p>
</div>
