<div class="content">
    <h1>Welcome to Orgatick, {{name}}!</h1>

    <p>
        <strong>Congratulations!</strong>
        Your account has been successfully created and verified. You're now part of the Orgatick family!
    </p>

    <p>
        We're thrilled to have you on board. Orgatick is designed to help you join, organize and manage your
        events effortlessly.
    </p>

    <!-- Features Section -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 5px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td align="center">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
                    style="max-width: 480px;">
                    <tr>
                        <td style="padding: 12px 0; text-align: center;">
                            <img width="24" height="24"
                                src="https://cdn.jsdelivr.net/gh/niyojan-org/email-assets/icons/lineal/compass.png"
                                alt="compass" class="dark-mode-safe"
                                style="-ms-interpolation-mode: bicubic; color: transparent; display: inline-block; vertical-align: middle; margin-right: 8px;" />
                            <span
                                style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; font-weight: bold; vertical-align: middle;">Discover
                                and join amazing events</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 12px 0; text-align: center;">
                            <img width="24" height="24"
                                src="https://cdn.jsdelivr.net/gh/niyojan-org/email-assets/icons/lineal/ticket.png"
                                alt="ticket" class="dark-mode-safe"
                                style="-ms-interpolation-mode: bicubic; color: transparent; display: inline-block; vertical-align: middle; margin-right: 8px;" />
                            <span
                                style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; font-weight: bold; vertical-align: middle;">Secure
                                tickets in just a few clicks</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 12px 0; text-align: center;">
                            <img width="24" height="24"
                                src="https://cdn.jsdelivr.net/gh/niyojan-org/email-assets/icons/lineal/history-rounded.png"
                                alt="activity-history" class="dark-mode-safe"
                                style="-ms-interpolation-mode: bicubic; color: transparent; display: inline-block; vertical-align: middle; margin-right: 8px;" />
                            <span
                                style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; font-weight: bold; vertical-align: middle;">Track
                                your event history and upcoming plans</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    {{> button
    url="www.orgatick.in/events"
    label="Explore Events Now"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="20px"
    }}

    <!-- Event Hosting Section -->
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 5px 0; background: linear-gradient(135deg, #004aad 0%, #002f6c 100%); border-radius: 8px; padding: 24px 20px;">
        <tr>
            <td align="center">
                <h3 style="color: #ffffff; font-family: Arial, sans-serif; font-size: 20px; margin: 0 0 12px 0;">Want
                    to Host Your Own Event?</h3>
                <p
                    style="color: #ffffff; font-family: Arial, sans-serif; font-size: 15px; line-height: 1.6; margin: 0 0 10px 0;">
                    Whether it's a workshop, concert, seminar, or social meetup — you can create and manage events
                    effortlessly with us.
                </p>
                <p
                    style="color: #ffffff; font-family: Arial, sans-serif; font-size: 15px; line-height: 1.6; margin: 0 0 20px 0;">
                    It's simple, secure, and built to help you grow your audience.
                </p>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0">
                    <tr>
                        <td align="center" style="border-radius: 6px; background-color: #ffffff;">
                            <a href="www.orgatick.in"
                                style="display: inline-block; padding: 12px 24px; font-family: Arial, sans-serif; font-size: 16px; color: #004aad; text-decoration: none; font-weight: bold; border-radius: 6px;">
                                Organize an Event with Us
                            </a>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</div>