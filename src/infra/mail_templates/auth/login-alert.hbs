<div class="content">
    <h1>New Login to Your Account</h1>

    <p>Hello {{name}},</p>

    <p>
        We detected a new login to your Orgatick account. If this was you, no action is required.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="padding: 8px 0;">
                            <strong style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">Time:</strong>
                            <span style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin-left: 8px;">{{loginTime}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 8px 0;">
                            <strong style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">Location:</strong>
                            <span style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin-left: 8px;">{{location}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 8px 0;">
                            <strong style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">IP Address:</strong>
                            <span style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin-left: 8px;">{{ipAddress}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 8px 0;">
                            <strong style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">Browser:</strong>
                            <span style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin-left: 8px;">{{browser}}</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #fee2e2; border-left: 4px solid #dc2626; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0 0 8px 0;">
                    <strong>Didn't recognize this activity?</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0;">
                    If you did not perform this login, your account may be compromised. Please reset your password
                    immediately and contact our support team.
                </p>
            </td>
        </tr>
    </table>

    {{> button
    url=securityUrl
    label="Secure My Account"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="20px"
    }}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    Best regards,<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
