<div class="content">
    <h1>Reset Your Password</h1>

    <p>Hello {{name}},</p>

    <p>
        We received a request to reset your password for your Orgatick account. Click the button below to create a
        new password.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td align="center">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; margin: 0 0 8px 0;">
                    Your password reset code:
                </p>
                <p
                    style="font-family: 'Courier New', monospace; font-size: 32px; font-weight: bold; color: #004aad; margin: 0; letter-spacing: 8px;">
                    {{resetCode}}
                </p>
            </td>
        </tr>
    </table>

    {{> button
    url=resetUrl
    label="Reset Password"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="20px"
    }}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0 0 8px 0;">
                    <strong>Important:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0;">
                    This password reset link will expire in <strong>10 minutes</strong>. If you did not request a password
                    reset, please ignore this email or contact support if you have concerns.
                </p>
            </td>
        </tr>
    </table>

    <p style="font-family: Arial, sans-serif; font-size: 14px; color: #6b7280; margin-top: 20px;">
        If the button doesn't work, copy and paste this link into your browser:
    </p>
    <p style="font-family: Arial, sans-serif; font-size: 13px; color: #004aad; word-break: break-all;">
        {{resetUrl}}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f3f4f6; border-radius: 6px; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0 0 8px 0;">
                    <strong>Security Tips:</strong>
                </p>
                <ul style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin: 0; padding-left: 20px;">
                    <li style="margin: 4px 0;">Use a strong, unique password</li>
                    <li style="margin: 4px 0;">Avoid using common words or personal information</li>
                    <li style="margin: 4px 0;">Consider using a password manager</li>
                </ul>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    Best regards,<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
