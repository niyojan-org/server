<div class="content">
    <h1>Email Address Change Confirmation</h1>

    <p>Hello {{name}},</p>

    <p>
        We received a request to change the email address associated with your Orgatick account.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="padding: 8px 0;">
                            <strong style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">Current Email:</strong>
                            <span style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin-left: 8px;">{{oldEmail}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 8px 0;">
                            <strong style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">New Email:</strong>
                            <span style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin-left: 8px;">{{newEmail}}</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <p>
        To complete this change and verify your new email address, please click the button below:
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td align="center">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #1f2937; margin: 0 0 8px 0;">
                    Your verification code:
                </p>
                <p
                    style="font-family: 'Courier New', monospace; font-size: 32px; font-weight: bold; color: #004aad; margin: 0; letter-spacing: 8px;">
                    {{verificationCode}}
                </p>
            </td>
        </tr>
    </table>

    {{> button
    url=verificationUrl
    label="Verify New Email"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="20px"
    }}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0 0 8px 0;">
                    <strong>Important:</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0;">
                    This verification link will expire in <strong>24 hours</strong>. Once verified, all future
                    communications will be sent to your new email address.
                </p>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #fee2e2; border-left: 4px solid #dc2626; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0 0 8px 0;">
                    <strong>Didn't request this change?</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0;">
                    If you did not request to change your email address, please secure your account immediately and
                    contact our support team.
                </p>
            </td>
        </tr>
    </table>

    <p style="font-family: Arial, sans-serif; font-size: 14px; color: #6b7280; margin-top: 20px;">
        If the button doesn't work, copy and paste this link into your browser:
    </p>
    <p style="font-family: Arial, sans-serif; font-size: 13px; color: #004aad; word-break: break-all;">
        {{verificationUrl}}
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    Best regards,<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
