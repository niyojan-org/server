<div class="content">
    <h1>Account Security Alert</h1>

    <p>Hello {{name}},</p>

    <p>
        For your security, your Orgatick account has been temporarily locked due to multiple failed login attempts.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #fee2e2; border-left: 4px solid #dc2626; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0 0 8px 0;">
                    <strong>Account Locked</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #991b1b; margin: 0;">
                    We detected {{attemptCount}} unsuccessful login attempts to your account. To protect your
                    information, we have temporarily locked your account.
                </p>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #f0f7ff; border-radius: 8px; padding: 20px;">
        <tr>
            <td>
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="padding: 8px 0;">
                            <strong style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">Time:</strong>
                            <span style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin-left: 8px;">{{lockTime}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 8px 0;">
                            <strong style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">Location:</strong>
                            <span style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin-left: 8px;">{{location}}</span>
                        </td>
                    </tr>
                    <tr>
                        <td style="padding: 8px 0;">
                            <strong style="font-family: Arial, sans-serif; font-size: 14px; color: #1f2937;">IP Address:</strong>
                            <span style="font-family: Arial, sans-serif; font-size: 14px; color: #4b5563; margin-left: 8px;">{{ipAddress}}</span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <p>
        <strong>To unlock your account:</strong>
    </p>

    <ul style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; line-height: 1.6;">
        <li>Click the button below to reset your password</li>
        <li>Create a strong, unique password</li>
        <li>Log in with your new credentials</li>
    </ul>

    {{> button
    url=unlockUrl
    label="Unlock Account"
    variant="primary"
    fullWidth=true
    marginTop="20px"
    marginBottom="20px"
    }}

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
        style="margin: 20px 0; background-color: #fef3c7; border-left: 4px solid #f59e0b; padding: 16px;">
        <tr>
            <td>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0 0 8px 0;">
                    <strong>Need Help?</strong>
                </p>
                <p style="font-family: Arial, sans-serif; font-size: 14px; color: #92400e; margin: 0;">
                    If you didn't attempt to log in or need assistance, please contact our support team at
                    <a href="mailto:contact@orgatick.com"
                        style="color: #004aad; text-decoration: none;">contact@orgatick.com</a>
                </p>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin-top: 30px;">
        <tr>
            <td align="">
                <p style="font-family: Arial, sans-serif; font-size: 15px; color: #4b5563; margin: 0;">
                    Best regards,<br />
                    <strong style="color: #1f2937;">- Orgatick Team</strong>
                </p>
            </td>
        </tr>
    </table>
</div>
