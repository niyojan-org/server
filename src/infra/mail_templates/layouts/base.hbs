<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <title>{{subject}}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
        /* Only VERY safe CSS here */
        @media only screen and (max-width: 600px) {
            .container {
                width: 100% !important;
            }
        }
        
        /* Prevent dark mode from inverting images */
        @media (prefers-color-scheme: dark) {
            .dark-mode-safe {
                filter: none !important;
            }
        }
        
        /* Gmail dark mode fix */
        [data-ogsc] .dark-mode-safe {
            filter: none !important;
        }
    </style>
</head>

<body style="margin:0; padding:0; background-color:#f3f4f6;">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%">
        <tr>
            <td align="center" style="padding:20px 10px;">
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
                    style="max-width:600px;" class="container">
                    <tr>
                        <td
                            style="background-color:#ffffff; border-radius:6px; font-family:Arial, sans-serif;">

                            {{> header}}

                            <div style="padding: 10px 20px; ">
                                {{{body}}}
                            </div>

                            {{> footer}}

                        </td>
                    </tr>
                </table>
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
                    style="max-width:600px;">
                    <tr>
                        <td align="center"
                            style="padding-top:12px; font-family:Arial, sans-serif; font-size:11px; color:#9ca3af;">
                            If you did not expect this email, you can ignore it.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>